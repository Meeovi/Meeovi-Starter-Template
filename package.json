{
   "name": "starter-template",
   "type": "module",
   "version": "1.0.0",
   "description": "Official M Framework starter template.",
   "author": "M Framework Labs (https://framework.meeovi.com)",
   "homepage": "https://framework.meeovi.com",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Meeovi/Meeovi-Starter-Template"
   },
   "bugs": {
      "url": "https://github.com/Meeovi/Meeovi-Starter-Template/issues"
   },
   "license": "MIT",
   "private": true,
   "scripts": {
      "starter-commit": "git add . && git commit -m \"ready for update\"",
      "starter-update": "git pull \"https://github.com/Meeovi/Meeovi-Starter-Template\"",
      "dev": "nuxt dev --host 0.0.0.0 --port 3001",
      "dev-sw": "SW=true nuxi dev",
      "build": "nuxt build",
      "build-sw": "SW=true nuxi build",
      "ts-node": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}'",
      "generate": "nuxt generate",
      "preview": "nuxt preview",
      "postinstall": "nuxt prepare"
   },
   "dependencies": {
      "@mframework/adapter-directus": "file:../../../adapters/directus",
      "@mframework/adapter-opensearch": "file:../../../adapters/opensearch",
      "@mframework/core": "file:../../../core",
      "@mframework/layer-commerce": "file:../../../layers/commerce",
      "@mframework/layer-shared": "file:../../../layers/shared",
      "@mframework/layer-social": "file:../../../layers/social",
      "@mframework/adapter-auth": "file:../../../adapters/auth",
      "@mframework/localization": "file:../../../layers/localization",
      "@nuxt/image": "^2.0.0",
      "@nuxt/ui": "^4.4.0",
      "@vite-pwa/nuxt": "^1.1.1",
      "lucide-vue-next": "^0.575.0",
      "nuxt": "^4.3.1",
      "tailwindcss": "^4.2.0"
   }
}
