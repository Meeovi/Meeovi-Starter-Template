{
   "name": "starter-template",
   "type": "module",
   "version": "1.0.0",
   "description": "Official Alternate Framework starter template.",
   "author": "Meeovi Labs (https://framework.meeovi.com)",
   "homepage": "https://framework.meeovi.com",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Meeovi/Meeovi-Starter-Template"
   },
   "bugs": {
      "url": "https://github.com/Meeovi/Meeovi-Starter-Template/issues"
   },
   "license": "MIT",
   "private": true,
   "scripts": {
      "starter-commit": "git add . && git commit -m \"ready for update\"",
      "starter-update": "git pull \"https://github.com/Meeovi/Meeovi-Starter-Template\"",
      "build": "nuxt build",
      "dev": "nuxt dev --port 3001",
      "ts-node": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}'",
      "generate": "nuxt generate",
      "preview": "nuxt preview",
      "postinstall": "nuxt prepare"
   },
   "dependencies": {
      "@meeovi/core": "^1.0.1",
      "@meeovi/directus-client": "^1.0.9",
      "@nuxt/image": "^1.11.0",
      "@nuxtjs/i18n": "^10.1.0",
      "eslint": "^9.32.0",
      "nuxt": "^4.2.2",
      "nuxt-security": "^2.4.0",
      "pinia": "^3.0.3",
      "vuetify-nuxt-module": "^0.18.8"
   },
   "devDependencies": {
      "@nuxtjs/turnstile": "^1.0.0",
      "@vueuse/core": "^14.0.0",
      "@vueuse/nuxt": "^14.0.0"
   }
}
